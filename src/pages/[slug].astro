---
import { getCollection } from "astro:content";
import { marked } from "marked";
import Layout from "../layouts/Layout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map(a => ({
    params: { slug: a.data.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const { title, categories, categorySlugs, image, excerpt } = article.data;

// Render markdown body via marked
const htmlContent = marked.parse(article.body || "");
---

<Layout title={title} description={excerpt} image={image}>
  <article class="article-single">
    {image && <img src={image} alt={title} class="article-featured-image" />}
    <h1>{title}</h1>
    <div class="article-meta">
      {categories.map((cat: string, i: number) => (
        <a href={`/category/${categorySlugs[i]}/`} class={`article-cat-chip cat-${categorySlugs[i]}`}>
          {cat}
        </a>
      ))}
    </div>

    <div class="article-body" set:html={htmlContent} />
  </article>
</Layout>
